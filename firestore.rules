rules_version = '2';

// Reglas de seguridad de Assistant Helper.
// Cada profesor (cuenta de Google) solo puede leer y escribir sus propios datos:
//   users/{uid}                     → perfil y configuración
//   users/{uid}/submissions/{docId} → trabajos analizados
// Nadie más (ni otros profesores ni visitantes sin sesión) puede verlos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /submissions/{submissionId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        // Límite de tamaño por documento para no rebasar el plan gratuito
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000;
      }
    }
    // Todo lo demás está cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
